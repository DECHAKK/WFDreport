# ============================================================
# Server Configuration
# ============================================================
PORT=3000
# NODE_ENV=development -> local XAMPP MySQL/MariaDB, no TLS
# NODE_ENV=production  -> Aiven MySQL, TLS required, config validated
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ============================================================
# Database Configuration
# Two supported environments. Copy this file to .env and fill in
# the section that matches your environment.
# ============================================================

# ---------- 1) Development: XAMPP MySQL/MariaDB (no TLS) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=insurance_landing_demo
DB_CONNECTION_LIMIT=10
# Optional, development only. Use a local socket when XAMPP rejects TCP
# root login on macOS. Ignored in production.
# DB_SOCKET_PATH=/Applications/XAMPP/xamppfiles/var/mysql/mysql.sock

# ---------- 2) TLS / SSL (Aiven) ----------
# Development: leave false (default, XAMPP unchanged).
# Production: TLS is always enabled regardless of this flag, and this flag
#             must be set to "true" or startup validation fails.
DB_SSL_ENABLED=false

# Path to the Aiven CA certificate (ca.pem downloaded from the Aiven console).
# REQUIRED in production. Must be a CA certificate only - never a private key.
# DB_SSL_CA_PATH=/etc/secrets/aiven-ca.pem

# Alternative to DB_SSL_CA_PATH for hosts where a secret file cannot be
# mounted. Paste the PEM text with escaped newlines (\n). Optional.
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# ---------- 3) Production: Aiven MySQL (TLS required) ----------
# Uncomment and supply real values through your secret manager.
# NEVER commit real credentials.
# NODE_ENV=production
# DB_HOST=<your-service-name>.aivencloud.com
# DB_PORT=<aiven-mysql-port>
# DB_USER=avnadmin
# DB_PASSWORD=<read-from-secret-manager>
# DB_NAME=defaultdb
# DB_CONNECTION_LIMIT=10
# DB_SSL_ENABLED=true
# DB_SSL_CA_PATH=/etc/secrets/aiven-ca.pem

# ============================================================
# Security & Rate Limiting
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
